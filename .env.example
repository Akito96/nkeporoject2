# Окружение приложения
APP_ENV=development
DEBUG=true

# PostgreSQL
POSTGRES_USER=coffee_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=coffee_shop
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Строка подключения для SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://coffee_user:change_me_in_production@db:5432/coffee_shop

# Безопасность (сгенерируйте случайную строку длиной >= 32 символа)
SECRET_KEY=change_me_to_a_long_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

# Продакшн-домен (для Nginx и Let's Encrypt)
DOMAIN=coffee.example.com
